# PHPStan — cobertura del código de plugins (change: phpstan-plugin-coverage)
#
# El `phpstan.neon` raíz analiza solo `src/` y `tests/` (código del core). Este
# perfil extiende la cobertura a los plugins instalados sin obligarlos a tener su
# propio toolchain: el binario y el bootstrap son del core.
#
# No lo invoques directo: `paths` y `scanDirectories` los resuelve
# `tools/phpstan-plugins.php` contra lo que esté instalado, porque los plugins
# son repositorios separados y opcionales. PHPStan aborta si un
# `scanDirectories` no existe, así que un install parcial rompería el gate.
#
# Uso:
#   ddev exec composer phpstan:plugins
#
# Reglas del perfil:
# - `universalObjectCratesClasses` modela las clases que publican propiedades
#   dinámicas por diseño: `fs_controller` (propiedades para las vistas) y
#   `fs_extended_model` (campos derivados del esquema y declarados con
#   `#[\AllowDynamicProperties]`). Sin esto habría que excluir esos errores por
#   archivo, que es más frágil y oculta accesos nuevos mal escritos.
# - Este perfil NO lleva baseline ni `ignoreErrors`: si un cambio agrega
#   errores, se corrige el código o el contrato de tipos, no se silencia.

parameters:
    level: 5
    bootstrapFiles:
        - phpstan-bootstrap.php

    universalObjectCratesClasses:
        - fs_controller
        - fs_extended_model

    dynamicConstantNames:
        - FS_DB_TYPE
        - FS_FOREIGN_KEYS
        - FS_CHECK_DB_TYPES
        - FS_ITEM_LIMIT
