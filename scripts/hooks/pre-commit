#!/bin/bash
#
# Pre-commit hook:
#   1. Reject staged credential material (security scan).
#   2. Regenerate Composer autoload when composer.json changes.
#      Ensures vendor/composer/ files are always in sync with composer.json,
#      preventing stale autoload references on production after git pull.
#
# ORDER IS LOAD-BEARING: the secret scan MUST stay ABOVE the composer.json early
# exit below. That exit returns 0 whenever composer.json is not staged, so a scan
# appended after it would never run for a normal commit.
#

# ---------------------------------------------------------------------------
# 1. Credential scan over the staged files
# ---------------------------------------------------------------------------
# Adjacency rule, shared with tests/Security/ServedTreeSecretScanTest.php: a
# finding is a 40- or 64-character hexadecimal blob written next to one of the
# tokens logkey / auth_sig / password / token, i.e. `logkey=<hex>`,
# `logkey: <hex>`, `"logkey": "<hex>"`.
#
# A bare "any 40/64-character hex blob" rule MUST NOT be used. tests/bootstrap.php
# defines a deterministic 64-hex FS_SECRET_KEY that is a test fixture, not a
# credential, and it is not adjacent to any of the four tokens; a non-adjacency
# rule would flag it and the false positive would force this control to be
# weakened or ignored.
#
# Scope mirrors the repository scan: third-party code (vendor/) and the
# separately versioned plugin repositories (plugins/) are out of scope. An
# inline `# nosecret` (or `// nosecret`) marker opts a legitimate line out.
SECRET_TOKENS='logkey|auth_sig|password|token'
SECRET_PATTERN='(logkey|auth_sig|password|token)["'"'"']?[[:space:]]*[=:][[:space:]]*["'"'"']?([0-9a-fA-F]{64}|[0-9a-fA-F]{40})([^0-9a-fA-F]|$)'
NOSECRET_PATTERN='(^|[^[:alnum:]_])(#|//)[[:space:]]*nosecret([^[:alnum:]_]|$)'
SCAN_EXCLUDED_PATH='^(vendor|plugins)/'

scan_staged_for_secrets() {
    local file match line token
    local failed=0

    while IFS= read -r -d '' file; do
        # Skip third-party and plugin content: not this repository's commits.
        if [[ "$file" =~ $SCAN_EXCLUDED_PATH ]]; then
            continue
        fi

        # Read the blob from the INDEX, never the working tree. A hook that greps
        # the file on disk misses two real cases: `git add -p` followed by
        # deleting the credential locally (the commit still carries it), and a
        # file removed from disk while still staged.
        # -I skips binary files; a match prints `line:content`, and only the line
        # number is echoed back. The credential value is never printed.
        local matches
        matches=$(git show ":$file" 2>/dev/null | grep -nIE "$SECRET_PATTERN" | grep -vE "$NOSECRET_PATTERN" || true)

        if [ -n "$matches" ]; then
            while IFS= read -r match; do
                line=${match%%:*}
                token=$(printf '%s\n' "$match" | grep -oE "$SECRET_TOKENS" | head -n 1)
                printf 'ERROR: possible credential material in %s:%s (value next to "%s")\n' \
                    "$file" "$line" "$token" >&2
            done <<< "$matches"
            failed=1
        fi
    done < <(git diff --cached --name-only --diff-filter=ACM -z)

    return "$failed"
}

if ! scan_staged_for_secrets; then
    echo "" >&2
    echo "Commit blocked: a staged file contains credential-shaped material." >&2
    echo "Replace the literal value with <redacted>, or add an inline '# nosecret'" >&2
    echo "marker when the value is a legitimate fixture." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# 2. Composer autoload on composer.json changes
# ---------------------------------------------------------------------------

# Check if composer.json is staged
STAGED_COMPOSER=$(git diff --cached --name-only | grep -x 'composer\.json')

if [ -z "$STAGED_COMPOSER" ]; then
    exit 0
fi

echo "composer.json changed — regenerating autoload..."

# Detect composer command: try native first, then ddev
COMPOSER_CMD=""
if command -v composer &>/dev/null; then
    COMPOSER_CMD="composer"
elif command -v ddev &>/dev/null && ddev exec which composer &>/dev/null 2>&1; then
    COMPOSER_CMD="ddev exec composer"
else
    echo "ERROR: composer not found. Install it or run 'composer dump-autoload' manually before committing."
    exit 1
fi

# Regenerate autoload files
$COMPOSER_CMD dump-autoload --no-interaction 2>/dev/null

if [ $? -ne 0 ]; then
    echo "ERROR: composer dump-autoload failed. Fix the issue before committing."
    exit 1
fi

# Stage the regenerated autoload files
git add vendor/composer/

echo "Autoload regenerated and staged."
