{#
/**
 * This file is part of FSFramework
 * Copyright (C) 2025 Javier Trujillo <mistertekcom@gmail.com>
 *
 * Opt-in htmx 4 boot macro (HCS-04): the ONLY loading point for htmx.
 * There is no global include — legacy screens never load htmx (HCS-09).
 *
 * Import once per opting-in view:
 *
 *     {% import 'Macro/Htmx.html.twig' as htmx %}
 *     {{ htmx.boot() }}
 *
 * The zero-argument form is the baseline contract (HCS-05): its output
 * must stay byte-identical.
 *
 * Views that swap in server fragments which may carry scripts can opt
 * into FSAjaxLoader's sanitization posture:
 *
 *     {{ htmx.boot({'allowScriptTags': false}) }}
 *
 * The config form additionally emits, BEFORE the htmx asset:
 *  1. A htmx-config <meta> with {"allowScriptTags": false}. Note: htmx
 *     4.0.0 merges unknown config keys but does not implement
 *     allowScriptTags, so the meta alone is inert.
 *  2. A nonce'd inline scrubber that listens for htmx:before:swap and
 *     strips script/object/embed/applet/iframe elements, on* handler
 *     attributes and javascript: URLs from every incoming fragment
 *     before insertion — mirroring FSAjaxLoader.sanitizeHtml (which is
 *     what actually enforces the posture under htmx 4).
 *
 * Baseline emissions, in order:
 *  1. An inline bootstrap that sets inherited hx-headers (X-CSRF-TOKEN)
 *     on document.documentElement BEFORE htmx initializes (D2). The
 *     deferred asset below therefore sees the inherited headers on
 *     every request it issues, including after body swaps.
 *  2. One nonce'd, deferred <script> tag for the vendored htmx asset.
 *
 * The token comes from csrf_token() — the same session token that
 * csrf_meta() renders (D7, HCS-07). htmx POSTs validate through the
 * existing validateCsrf() flow via the X-CSRF-TOKEN header; GET
 * fragment requests need no token (HCS-08).
 */
#}
{% macro boot(config = {}) %}
{%- if config.allowScriptTags is same as(false) %}
    <meta name="htmx-config" content='{{ {"allowScriptTags": false}|json_encode|e('html_attr') }}'>
    <script {{ csp_nonce_attr() }}>
        // htmx 4.0.0 dropped allowScriptTags: scripts inside swapped content
        // are always re-created and executed. Replicate FSAjaxLoader's
        // sanitizeHtml posture by scrubbing fragments before insertion.
        document.addEventListener('htmx:before:swap', function (evt) {
            var tasks = evt.detail && evt.detail.tasks;
            if (!tasks) {
                return;
            }
            tasks.forEach(function (task) {
                var frag = task.fragment;
                if (!frag || !frag.querySelectorAll) {
                    return;
                }
                frag.querySelectorAll('script,object,embed,applet,iframe').forEach(function (el) {
                    el.remove();
                });
                frag.querySelectorAll('*').forEach(function (el) {
                    Array.prototype.slice.call(el.attributes).forEach(function (attr) {
                        var name = attr.name.toLowerCase();
                        var value = String(attr.value).trim().toLowerCase();
                        var dangerous = name.indexOf('on') === 0
                            || ((name === 'href' || name === 'src') && value.indexOf('javascript:') === 0);
                        if (dangerous) {
                            el.removeAttribute(attr.name);
                        }
                    });
                });
            });
        });
    </script>
{%- endif %}
    <script {{ csp_nonce_attr() }}>
        document.documentElement.setAttribute(
            'hx-headers:inherited',
            JSON.stringify({ 'X-CSRF-TOKEN': '{{ csrf_token() }}' })
        );
    </script>
    <script src="view/js/htmx.min.js" {{ csp_nonce_attr() }} defer></script>
{% endmacro %}
