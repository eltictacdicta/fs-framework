{{ include('header.html.twig') }}

<script type="text/javascript">
   $(document).ready(function() {
      $("#b_nuevo_grupo").click(function(event) {
         event.preventDefault();
         $("#modal_nuevo_grupo").modal('show');
         document.f_nuevo_grupo.ncodgrupo.focus();
      });
      $(".b_eliminar_grupo").click(function(event) {
         event.preventDefault();
         var form = $(this).closest('form');
         bootbox.confirm({
            message: '{{ trans('delete-group')|e('js') }}?',
            title: '<b>{{ trans('attention')|e('js') }}</b>',
            callback: function(result) {
               if (result) {
                  form.submit();
               }
            }
         });
      });
   });
</script>

<div class="container-fluid">
   <div class="row">
      <div class="col-sm-6 col-xs-7">
         <div class="btn-group">
            <a class="btn btn-sm btn-default" href="{{ fsc.url() }}" title="Recargar la página">
               <span class="glyphicon glyphicon-refresh"></span>
            </a>
         </div>
      </div>
      <div class="col-sm-6 col-xs-5 text-right">
         <h2 style="margin-top: 0px;">{{ trans('groups') }}</h2>
      </div>
   </div>
   <div class="row">
      <div class="col-sm-6">
         <a id="b_nuevo_grupo" class="btn btn-xs btn-success" href="#">
            <span class="glyphicon glyphicon-plus"></span>
            <span class="hidden-xs">&nbsp;{{ trans('new-group') }}</span>
         </a>
      </div>
      <div class="col-sm-6 text-right">
         <p class="help-block">
            <i class="fa fa-info-circle" aria-hidden="true"></i>&nbsp;
            Los grupos son organizativos: no conceden permisos.
         </p>
      </div>
   </div>
</div>

<div class="table-responsive">
   <table class="table table-hover">
      <thead>
         <tr>
            <th class="text-left">{{ trans('group-code') }}</th>
            <th class="text-left">{{ trans('group-description') }}</th>
            <th class="text-right"></th>
         </tr>
      </thead>
      {% for value in fsc.groups %}
      <tr class="clickableRow" href="{{ value.url() }}">
         <td><a href="{{ value.url() }}">{{ value.codgrupo }}</a></td>
         <td>{{ value.descripcion }}</td>
         <td class="text-right">
            {% if fsc.allow_delete %}
            <form action="{{ fsc.url() }}" method="post" class="form-inline">
               {{ csrf_field() }}
               <input type="hidden" name="delete_grupo" value="{{ value.codgrupo }}"/>
               <button type="button" class="btn btn-xs btn-danger b_eliminar_grupo" title="{{ trans('delete-group') }}">
                  <span class="glyphicon glyphicon-trash"></span>
               </button>
            </form>
            {% endif %}
         </td>
      </tr>
      {% else %}
      <tr class="warning">
         <td colspan="3">{{ trans('no-groups') }}</td>
      </tr>
      {% endfor %}
   </table>
</div>

<div class="modal" id="modal_nuevo_grupo">
   <div class="modal-dialog">
      <div class="modal-content">
         <form name="f_nuevo_grupo" class="form" role="form" action="{{ fsc.url() }}" method="post">
            {{ csrf_field() }}
            <div class="modal-header">
               <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">&times;</button>
               <h4 class="modal-title">
                  <i class="fa fa-users" aria-hidden="true"></i>&nbsp; {{ trans('new-group') }}
               </h4>
            </div>
            <div class="modal-body">
               <div class="form-group">
                  <label for="ng_codigo" class="sr-only">{{ trans('group-code') }}</label>
                  {{ trans('group-code') }}:
                  <input type="text" id="ng_codigo" name="ncodgrupo" class="form-control" maxlength="20" autocomplete="off" required=""/>
               </div>
               <div class="form-group">
                  <label for="ng_descripcion" class="sr-only">{{ trans('group-description') }}</label>
                  {{ trans('group-description') }}:
                  <input type="text" id="ng_descripcion" name="descripcion" class="form-control" maxlength="200" autocomplete="off" required=""/>
               </div>
            </div>
            <div class="modal-footer">
               <button class="btn btn-sm btn-primary" type="submit">
                  <span class="glyphicon glyphicon-floppy-disk"></span>&nbsp; {{ trans('save') }}
               </button>
            </div>
         </form>
      </div>
   </div>
</div>

{{ include('footer.html.twig') }}
