{% import 'Macro/Htmx.html.twig' as htmx %}
{% import 'Macro/HtmxCrud.html.twig' as crud %}
{% import 'Macro/Alpine.html.twig' as alpine %}

{{ include('header.html.twig') }}

{# htmx core boot (htmx.min.js) + crud helpers (fs-dialogs, flash toasts, csrf) #}
{{ htmx.boot() }}
{{ crud.boot() }}

<style>
    [x-cloak] {
        display: none !important;
    }
    .htmx-alpine-modal {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        z-index: 1050;
        overflow-y: auto;
        outline: 0;
    }
    .htmx-alpine-backdrop {
        position: fixed;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        z-index: 1040;
        background-color: #000;
        opacity: 0.5;
    }
    .agentes-inline-form {
        display: inline-block;
    }
</style>

{# Alpine (CSP build) component registration — inline classic script runs
   during parse, BEFORE the deferred Alpine boot below, so the alpine:init
   listener is guaranteed to fire before Alpine walks the tree. #}
<script type="text/javascript">
(function () {
    function registerAgenteAlpineComponents() {
        // CSP build: directive expressions are limited to method calls;
        // all behavior lives in these components.
        Alpine.data('agenteAddModal', function () {
            return {
                open: false,
                init: function () {
                    window.addEventListener('agentes-add-open', this.openModal.bind(this));
                    window.addEventListener('fs:modal-close', this.closeAndReset.bind(this));
                    window.addEventListener('keydown', this.onKeydown.bind(this));
                },
                openModal: function () {
                    this.open = true;
                    document.body.classList.add('modal-open');
                    var input = document.querySelector('#modal_nuevo_agente input[name="nombre"]');
                    if (input) {
                        input.focus();
                    }
                },
                close: function () {
                    this.open = false;
                    document.body.classList.remove('modal-open');
                },
                closeAndReset: function () {
                    this.close();
                    var form = document.querySelector('#modal_nuevo_agente form');
                    if (form) {
                        form.reset();
                    }
                },
                onKeydown: function (e) {
                    if (e.key === 'Escape' && this.open) {
                        this.close();
                    }
                }
            };
        });
        Alpine.data('agenteEditModal', function () {
            return {
                open: true,
                init: function () {
                    window.addEventListener('fs:modal-close', this.close.bind(this));
                    window.addEventListener('keydown', this.onKeydown.bind(this));
                },
                close: function () {
                    this.open = false;
                    document.body.classList.remove('modal-open');
                },
                onKeydown: function (e) {
                    if (e.key === 'Escape' && this.open) {
                        this.close();
                    }
                }
            };
        });
    }

    if (window.Alpine) {
        registerAgenteAlpineComponents();
    } else {
        document.addEventListener('alpine:init', registerAgenteAlpineComponents);
    }
})();
</script>

<div class="container-fluid">
    <div class="row">
       <div class="col-sm-6 col-xs-7">
          <div class="btn-group">
             <a class="btn btn-sm btn-default" href="{{ fsc.url() }}" title="Recargar la página">
                <span class="glyphicon glyphicon-refresh"></span>
             </a>
             {% if fsc.page.is_default() %}
             <a class="btn btn-sm btn-default active" href="{{ fsc.url() }}&default_page=FALSE" title="Marcada como página de inicio (pulsa de nuevo para desmarcar)">
                <i class="fa fa-bookmark" aria-hidden="true"></i>
             </a>
             {% else %}
             <a class="btn btn-sm btn-default" href="{{ fsc.url() }}&default_page=TRUE" title="Marcar como página de inicio">
                <i class="fa fa-bookmark-o" aria-hidden="true"></i>
             </a>
             {% endif %}
          </div>
          <div class="btn-group">
             {% if fsc.show_debaja %}
             <a class="btn btn-sm btn-default active" href="{{ fsc.url() }}" title="Ocultar agentes de baja">
                <i class="fa fa-eye" aria-hidden="true"></i>
             </a>
             {% else %}
             <a class="btn btn-sm btn-default" href="{{ fsc.url() }}&debaja=TRUE" title="Mostrar también agentes de baja (f_baja no elimina el registro)">
                <i class="fa fa-eye-slash" aria-hidden="true"></i>
             </a>
             {% endif %}
          </div>
          <div class="btn-group">
             {% for value in fsc.extensions %}
                {% if value.type == 'button' %}
                <a href="index.php?page={{ value.from }}{{ value.params }}" class="btn btn-sm btn-default">{{ value.text }}</a>
                {% endif %}
             {% endfor %}
          </div>
       </div>
       <div class="col-sm-6 col-xs-5 text-right">
          <h2 style="margin-top: 0px;">Agentes</h2>
       </div>
    </div>
</div>

<div class="container-fluid" style="margin-top: 15px; margin-bottom: 10px;">
    <div class="row">
        <div class="col-sm-6">
            <button type="button" class="btn btn-xs btn-success"
                    onclick="document.dispatchEvent(new CustomEvent('agentes-add-open', {bubbles: true}))">
                <span class="glyphicon glyphicon-plus"></span>
                <span class="hidden-xs">&nbsp;Nuevo</span>
            </button>
        </div>
        <div class="col-sm-6 text-right">
            <p class="help-block">
                <i class="fa fa-info-circle" aria-hidden="true"></i>&nbsp;
                Gestión de agentes/empleados del sistema. Edición sin recargar la página.
            </p>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th class="text-left">Código</th>
                <th class="text-left">Nombre</th>
                <th class="text-left">Apellidos</th>
                <th class="text-left">DNI/CIF</th>
                <th class="text-left">Email</th>
                <th class="text-left">Teléfono</th>
                <th class="text-left">Cargo</th>
                <th class="text-left">Ciudad</th>
                <th class="text-right">% Comisión</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody id="agentes-tbody">
            {% for row in fsc.agente.all(fsc.show_debaja) %}
            {% include 'partials/agentes/agente_row.html.twig' with {row: row, fsc: fsc} %}
            {% else %}
            <tr class="warning">
                <td colspan="10">Sin resultados.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

{# Modal Nuevo Agente — Alpine (CSP build): opened via the agentes-add-open
   event from the toolbar button; closed by fs:modal-close (server-sent). #}
<div x-data="agenteAddModal" x-cloak>
    <div class="htmx-alpine-backdrop" x-show="open" @click="close()"></div>
    <div class="htmx-alpine-modal" id="modal_nuevo_agente" x-show="open" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <form name="f_nuevo_agente" class="form" role="form" action="{{ fsc.url() }}" method="post"
                      hx-post="{{ fsc.url() }}"
                      hx-target="#agentes-tbody" hx-swap="innerHTML"
                      data-fs-csrf-strip>
                    {{ csrf_field() }}
                    <input type="hidden" name="save_agente" value="1"/>
                    <input type="hidden" name="codagente" value=""/>
                    <div class="modal-header">
                        <button type="button" class="close" @click="close()" aria-hidden="true">&times;</button>
                        <h4 class="modal-title">
                            <i class="fa fa-user" aria-hidden="true"></i>&nbsp; Nuevo agente
                        </h4>
                    </div>
                    <div class="modal-body">
                        <div class="form-group">
                            <label class="control-label">Nombre:</label>
                            <input class="form-control" type="text" name="nombre" maxlength="50" required/>
                        </div>
                        <div class="form-group">
                            <label class="control-label">Apellidos:</label>
                            <input class="form-control" type="text" name="apellidos" maxlength="100" required/>
                        </div>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label class="control-label">DNI/CIF:</label>
                                    <input class="form-control" type="text" name="dnicif" maxlength="20"/>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label class="control-label">Teléfono:</label>
                                    <input class="form-control" type="tel" name="telefono" maxlength="20"/>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label">Email:</label>
                            <div class="input-group">
                                <span class="input-group-addon"><span class="glyphicon glyphicon-envelope"></span></span>
                                <input class="form-control" type="email" name="email"/>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label">Cargo:</label>
                            <input class="form-control" type="text" name="cargo" maxlength="50"/>
                        </div>
                        <div class="form-group">
                            <label class="control-label">Dirección:</label>
                            <textarea class="form-control" name="direccion" rows="2"></textarea>
                        </div>
                        <div class="row">
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label class="control-label">Código Postal:</label>
                                    <input class="form-control" type="text" name="codpostal" maxlength="10"/>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label class="control-label">Provincia:</label>
                                    <input class="form-control" type="text" name="provincia" maxlength="50"/>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label class="control-label">Ciudad:</label>
                                    <input class="form-control" type="text" name="ciudad" maxlength="50"/>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label class="control-label">Fecha de nacimiento:</label>
                                    <input class="form-control" type="date" name="f_nacimiento"/>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label class="control-label">Fecha de alta:</label>
                                    <input class="form-control" type="date" name="f_alta"/>
                                </div>
                            </div>
                            <div class="col-sm-4">
                                <div class="form-group">
                                    <label class="control-label">Fecha de baja:</label>
                                    <input class="form-control" type="date" name="f_baja"/>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label class="control-label">% Comisión:</label>
                                    <input class="form-control" type="number" step="0.01" name="porcomision"/>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label class="control-label">Nº Seguridad Social:</label>
                                    <input class="form-control" type="text" name="seg_social" maxlength="20"/>
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="control-label">Cuenta bancaria:</label>
                            <input class="form-control" type="text" name="banco" maxlength="50"/>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-default" @click="close()">
                            <i class="fa fa-times"></i> Cancelar
                        </button>
                        <button class="btn btn-sm btn-primary" type="submit">
                            <span class="glyphicon glyphicon-floppy-disk"></span>&nbsp; Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

{# Modal Editar Agente — HTMX-driven: row edit links fetch this modal as a
   fragment into the container below. The same partial renders inline here
   for the no-JS fallback when the page loads with ?cod=CODE. #}
<div id="agente-edit-container"></div>
{% if fsc.editing_agente %}
{% include 'partials/agentes/edit_modal.html.twig' %}
{% endif %}

{# Alpine CSP build — AFTER the inline registration above, before... no:
   alpine must run after the registration script (it does: this tag is
   placed after it) and the tree walk resolves x-data components. #}
{{ alpine.boot() }}

{{ include('footer.html.twig') }}
