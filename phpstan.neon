includes:
    - phpstan-baseline.neon
    - vendor/dev-tools/phpstan/phpstan-symfony/extension.neon
    - vendor/dev-tools/phpstan/phpstan-doctrine/extension.neon

parameters:
    level: 5
    bootstrapFiles:
        - phpstan-bootstrap.php
    paths:
        - src
        - tests
    dynamicConstantNames:
        - FS_DB_TYPE
        - FS_FOREIGN_KEYS
        - FS_CHECK_DB_TYPES
    scanFiles:
        - base/fs_maintenance_mode.php
        - base/fs_plugin_manager.php
        - base/install_security.php
        - controller/admin_home.php
        - controller/force_password_change.php
    ignoreErrors:
        # Symbols from optional plugins (separate gitignored repos) are unknown to
        # PHPStan when the plugin is not installed; runtime guards handle absence.
        -
            identifier: function.notFound
            path: src/Core/Plugin/PluginEnableOrchestrator.php
        -
            identifier: argument.type
            path: src/Core/Plugin/PluginEnableOrchestrator.php
        -
            identifier: return.type
            path: src/Core/Plugin/PluginEnableOrchestrator.php
        -
            identifier: function.notFound
            path: tests/Base/UpdaterPathValidationTest.php