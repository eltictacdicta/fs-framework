{
    "name": "mrd/oidc-core",
    "version": "0.2.5",
    "description": "Reusable OIDC core utilities for One Login clients",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "symfony/http-client": "^7.4",
        "symfony/options-resolver": "^7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "shipmonk/dead-code-detector": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "OneLogin\\OidcCore\\": "src/"
        }
    },
    "scripts": {
        "test": "php vendor/bin/phpunit -c phpunit.xml",
        "phpstan": "php vendor/bin/phpstan analyse -c phpstan.neon --memory-limit=1G",
        "phpstan:dead-code": "php vendor/bin/phpstan analyse -c phpstan-dead-code.neon --memory-limit=1G"
    }
}