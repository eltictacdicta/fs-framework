<?xml version="1.0" encoding="UTF-8"?>
<!--
    Document   : idiomas.xml
    Description:
        Estructura de la tabla core de idiomas (registro de lenguajes para
        contenido multiidioma). Sin clave foranea sobre codidioma: la limpieza
        de traducciones huerfanas es responsabilidad de la aplicacion (D12).
-->
<tabla>
    <columna>
        <nombre>codidioma</nombre>
        <tipo>character varying(5)</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>nombre</nombre>
        <tipo>character varying(50)</tipo>
        <nulo>NO</nulo>
    </columna>
    <columna>
        <nombre>activo</nombre>
        <tipo>boolean</tipo>
        <nulo>NO</nulo>
        <defecto>true</defecto>
    </columna>
    <columna>
        <nombre>por_defecto</nombre>
        <tipo>boolean</tipo>
        <nulo>NO</nulo>
        <defecto>false</defecto>
    </columna>
    <restriccion>
        <nombre>idiomas_pkey</nombre>
        <consulta>PRIMARY KEY (codidioma)</consulta>
    </restriccion>
</tabla>
